          {
            "name": "Full_Team_Name",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "lineageTag": "c82a7270-32ca-4dd9-a8a1-6f946e70c1e1",

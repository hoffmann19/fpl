            "summarizeBy": "none"
          }
        ],
        "lineageTag": "7e42644d-c054-420b-98ad-1799f24c7e97",
        "measures": [
          {
            "name": "Starting Points Contributed",
            "expression": "CALCULATE(SUM(master_lineups[Points]), master_lineups[Is Starting] = TRUE())",
            "formatString": "#,0",
            "lineageTag": "ffa3d7bf-750c-4e04-9911-c4c4e8d5a6eb"
          },
          {
            "name": "Captain Points (Doubled)",
            "expression": "CALCULATE(SUM(master_lineups[Points]) * 2, master_lineups[Captain] = TRUE())",
            "formatString": "#,0",
            "lineageTag": "71e3cf75-2df4-4b86-bf12-bc4bef923f52"
          },
          {
            "name": "Captain Points Contribution",
            "expression": "CALCULATE(SUM(master_lineups[Points]), master_lineups[Captain] = TRUE())",
            "formatString": "#,0",
            "lineageTag": "1def5d5f-607d-4035-b313-c04f7935c211"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(\"C:/Users/Dan/projects/fpl/fpl_data/master_lineups.csv\"),[Delimiter=\",\", Columns=12, Encoding=65001, QuoteStyle=QuoteStyle.None]),",
                "    #\"Promoted Headers\" = Table.PromoteHeaders(Source, [PromoteAllScalarTypes=true]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Promoted Headers\",{",
                "        {\"Gameweek\", Int64.Type}, {\"Manager Name\", type text}, {\"Team Name\", type text}, {\"Player Name\", type text},",
                "        {\"Club\", type text}, {\"Position\", type text}, {\"Points\", Int64.Type},",
                "        {\"Captain\", type logical}, {\"Vice Captain\", type logical}, {\"Is Starting\", type logical},",
                "        {\"Subbed In\", type logical}, {\"Subbed Out\", type logical}",
                "    }),",
                "    #\"Added Key\" = Table.AddColumn(#\"Changed Type\", \"Manager_GW_Key\", each [Manager Name] & \"-\" & Text.From([Gameweek]), type text),",
                "    #\"Added Team Name\" = Table.AddColumn(#\"Added Key\", \"Full_Team_Name\", each",
                "        if [Club] = \"ARS\" then \"Arsenal\"",
                "        else if [Club] = \"AVL\" then \"Aston Villa\"",
                "        else if [Club] = \"BOU\" then \"Bournemouth\"",
                "        else if [Club] = \"BRE\" then \"Brentford\"",
                "        else if [Club] = \"BHA\" then \"Brighton\"",
                "        else if [Club] = \"CHE\" then \"Chelsea\"",
                "        else if [Club] = \"COV\" then \"Coventry City\"",
                "        else if [Club] = \"CRY\" then \"Crystal Palace\"",
                "        else if [Club] = \"EVE\" then \"Everton\"",
                "        else if [Club] = \"FUL\" then \"Fulham\"",
                "        else if [Club] = \"HUL\" then \"Hull City\"",
                "        else if [Club] = \"IPS\" then \"Ipswich Town\"",
                "        else if [Club] = \"LEE\" then \"Leeds\"",
                "        else if [Club] = \"LIV\" then \"Liverpool\"",
                "        else if [Club] = \"MCI\" then \"Man City\"",
                "        else if [Club] = \"MUN\" then \"Man Utd\"",
                "        else if [Club] = \"NEW\" then \"Newcastle\"",
                "        else if [Club] = \"NFO\" then \"Nott'm Forest\"",
                "        else if [Club] = \"TOT\" then \"Spurs\"",
                "        else if [Club] = \"SUN\" then \"Sunderland\"",
                "        else if [Club] = \"BUR\" then \"Burnley\"",
                "        else if [Club] = \"WHU\" then \"West Ham\"",
                "        else if [Club] = \"WOL\" then \"Wolves\"",
                "        else [Club], type text),",
                "    #\"Added Player Key\" = Table.AddColumn(#\"Added Team Name\", \"Player_Team_Key\", each [Player Name] & \"-\" & [Full_Team_Name], type text)",
                "in",
                "    #\"Added Player Key\""
              ],
              "type": "m"
            }
          }
        ]
      },

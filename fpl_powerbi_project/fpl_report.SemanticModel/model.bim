            "displayFolder": "Key Metrics",
            "expression": "SUM(fpl_players[cost_26_27_m]) - SUM(fpl_players[cost_25_26_end_m])",
            "formatString": "0.00",
            "lineageTag": "dc6bfbb5-526b-49d1-b124-4d872af92660"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(\"C:/Users/Dan/projects/fpl/fpl_data/fpl_players_2025_26_vs_2026_27.csv\"),[Delimiter=\",\", Columns=15, Encoding=65001, QuoteStyle=QuoteStyle.None]),",
                "    #\"Promoted Headers\" = Table.PromoteHeaders(Source, [PromoteAllScalarTypes=true]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Promoted Headers\",{",
                "        {\"id\", Int64.Type}, {\"web_name\", type text}, {\"full_name\", type text}, {\"team\", type text},",
                "        {\"position\", type text}, {\"cost_26_27_m\", type number}, {\"cost_25_26_start_m\", type number},",
                "        {\"cost_25_26_end_m\", type number}, {\"cost_25_26_season_change_m\", type number},",
                "        {\"price_change_yoy_m\", type number}, {\"selected_by_percent\", type number},",
                "        {\"points_25_26\", Int64.Type}, {\"minutes_25_26\", Int64.Type},",
                "        {\"goals_25_26\", Int64.Type}, {\"assists_25_26\", Int64.Type}",
                "    }),",
                "    #\"Added Player Key\" = Table.AddColumn(#\"Changed Type\", \"Player_Team_Key\", each [web_name] & \"-\" & [team], type text)",
                "in",
                "    #\"Added Player Key\""
              ],
              "type": "m"
            }
